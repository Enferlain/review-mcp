# API key for GLM-5.2 (required)
AI_API_KEY=your_api_key_here

# Accepted fallback key names
# ZHIPU_API_KEY=your_api_key_here
# GLM_API_KEY=your_api_key_here

# Optional: Override the API base URL
# ZHIPU_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Optional: Override the review model (can also be chosen per call via the
# model parameter; the list_models tool shows what the endpoint offers)
# AI_MODEL=glm-5.3-flash
# ZHIPU_MODEL=glm-5.3-flash

# Optional: Reasoning effort for the glm-4.5+ model family (default: max;
# can also be chosen per call via the reasoning_effort parameter)
# AI_REASONING_EFFORT=max
# ZHIPU_REASONING_EFFORT=max

# Optional: Review-turn budget, including one reserved final synthesis.
# Invalid values or values below 2 fall back to 64; retries may add HTTP attempts.
# MAX_REVIEW_MODEL_CALLS=64

# Optional: Timeout for each model API request (default: 900 seconds)
# AI_API_TIMEOUT_SECONDS=900

# Optional: Explicit character-based safety ceiling (unset by default).
# Character counts are not model token counts; the completion response's
# usage.prompt_tokens is authoritative and the provider enforces its own window.
# MAX_REVIEW_CONTEXT_CHARS=200000

# Optional: Per-tool result ceiling before truncation (default: 20000 chars)
# MAX_REVIEW_TOOL_RESULT_CHARS=20000

# Optional: End the MCP tool call before the host-level timeout (default: 1800)
# REVIEW_TOOL_TIMEOUT_SECONDS=1800

# Optional: Include diagnostic trace in returned and saved reviews (default: false)
# REVIEW_MCP_INCLUDE_TRACE=false
