# API key for GLM-5.2 (required)
AI_API_KEY=your_api_key_here

# Backward-compatible fallback key name
# ZHIPU_API_KEY=your_api_key_here

# Optional: Override the API base URL
# ZHIPU_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Optional: Override the review model
# AI_MODEL=glm-5.2
# ZHIPU_MODEL=glm-5.2

# Optional: GLM-5.2 reasoning effort (default: high)
# AI_REASONING_EFFORT=high
# ZHIPU_REASONING_EFFORT=high

# Optional: Timeout for each model API request (default: 900 seconds)
# AI_API_TIMEOUT_SECONDS=900

# Optional: Max iterations for agentic review (default: 20, capped at 50)
# MAX_REVIEW_ITERATIONS=20

# Optional: Accumulated input ceiling (default: 868928 chars)
# GLM-5.2 has a 1M-token total window; the default reserves its 131072-token
# maximum output and uses characters as a conservative dependency-free proxy.
# MAX_REVIEW_CONTEXT_CHARS=868928

# Optional: Per-tool result ceiling before truncation (default: 20000 chars)
# MAX_REVIEW_TOOL_RESULT_CHARS=20000

# Optional: End the MCP tool call before the host-level timeout (default: 1800)
# REVIEW_TOOL_TIMEOUT_SECONDS=1800

# Optional: Include diagnostic trace details in review responses
# REVIEW_MCP_INCLUDE_TRACE=false
